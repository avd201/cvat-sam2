# Copy to `.env` in this folder (next to docker-compose.sam2.yml). `docker compose` reads it automatically,
# also when started with sudo (exported shell variables would be dropped by sudo).

# Public host name of CVAT. Must match the address in the browser (Traefik routes by Host). Default: localhost
#CVAT_HOST=localhost

# Cap PyTorch's GPU memory (GiB) to rehearse a smaller card on this one. Empty/absent = no cap.
# The cap covers PyTorch's allocator only; nvidia-smi additionally shows the CUDA context (~0.5 GB).
# Rough rehearsal of the 24 GB A10 (nvidia-smi shows ~23028 MiB there; check on the real VM):
#GPU_MEMORY_LIMIT_GB=21.5
