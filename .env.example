# Shared by BOTH projects through scripts/compose.sh. Copy to .env in this directory.
# Browser hostname/IP only: no scheme, port, or path. localhost works with an SSH tunnel.
CVAT_HOST=localhost

# Required only for scripts/compose.sh --https (public DNS and inbound TCP 80/443 required).
#ACME_EMAIL=you@example.org

# Optional PyTorch allocator cap in GiB; leave unset for normal operation.
#GPU_MEMORY_LIMIT_GB=21.5

# Limits include the prompt frame. Start with short runs and one object.
MAX_PROPAGATION_FRAMES=600
MAX_OBJECTS=8
MAX_QUEUE=8
EMBEDDING_CACHE_SIZE=4
